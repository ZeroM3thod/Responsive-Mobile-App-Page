.work-details article {
  display: grid;
  grid-template: auto auto / 40px minmax(0, 1fr);
  align-items: center;
  min-width: 0;
  padding: 0 14px;
  border-right: 1px solid #d6eaf1;
}

.work-details article:last-child { border: 0; }
.work-details article span {
  display: grid;
  grid-row: span 2;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  color: white;
  background: #0b86e7;
}

.work-details small {
  min-width: 0;
  font-size: 10px;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.work-details b {
  min-width: 0;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

.work-slogan {
  margin: 23px 0 3px;
  color: #0870bc;
  font-size: clamp(11px, 3.4vw, 14px);
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}

.bottom-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  height: 77px;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #e3eef3;
  background: rgba(255,255,255,.97);
  box-shadow: 0 -3px 10px rgba(1, 74, 115, .05);
  backdrop-filter: blur(10px);
}

.bottom-nav button {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  border: 0;
  border-right: 1px solid #e1edf2;
  color: #416f9e;
  background: transparent;
}

.bottom-nav button:last-child { border: 0; }
.bottom-nav button.active { color: #008ee4; }
.bottom-nav span {
  display: block;
  width: 100%;
  padding: 0 2px;
  font-size: clamp(8px, 2.6vw, 11px);
  font-weight: 500;
  line-height: 1.2;
  overflow-wrap: anywhere;
  text-align: center;
}

.toast {
  position: fixed;
  z-index: 50;
  bottom: 91px;
  left: 50%;
  width: max-content;
  max-width: calc(100% - 40px);
  padding: 10px 16px;
  border-radius: 999px;
  color: white;
  background: rgba(3, 38, 80, .9);
  box-shadow: 0 4px 18px rgba(0,0,0,.2);
  font-size: 13px;
  text-align: center;
  transform: translateX(-50%);
  animation: toast-in .2s ease-out;
}

.placeholder {
  display: grid;
  min-height: calc(100dvh - 181px);
  place-items: center;
}

.placeholder > div {
  text-align: center;
}

.placeholder span {
  display: grid;
  place-items: center;
  width: 104px;
  height: 104px;
  margin: 0 auto 16px;
  border-radius: 50%;
  color: white;
  background: linear-gradient(145deg, #08b9ef, #0968dc);
}

.placeholder h1 { font-size: 27px; }
.placeholder p { margin-top: 4px; color: #557493; font-size: 15px; }

@keyframes toast-in {
  from { opacity: 0; transform: translate(-50%, 8px); }
}

@media (max-width: 600px) {
  .app-header { padding-inline: 14px; }
  .avatar {
    flex-basis: 56px;
    height: 60px;
  }
  .identity strong { font-size: clamp(19px, 5.5vw, 22px); }
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 6px;
  }
  .stat-cell {
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 7px;
    min-height: 78px;
    padding: 9px 7px;
    border-right: 1px solid #d4e9ef;
    border-bottom: 1px solid #d4e9ef;
  }
  .stat-cell:nth-child(2n) { border-right: 0; }
  .stat-cell:nth-child(3) { border-right: 1px solid #d4e9ef; }
  .stat-cell:nth-child(n+5) { border-bottom: 0; }
  .small-icon { flex-basis: 34px; width: 34px; height: 34px; }
  .stat-cell span:not(.small-icon) { font-size: 11px; }
  .stat-cell strong { font-size: clamp(14px, 4.4vw, 17px); }
  .quick-grid b { font-size: 13px; }
  .product-banner {
    min-height: 120px;
    padding-inline: 14px;
  }
  .product-banner > div:nth-child(2) { padding-right: 82px; }
  .product-banner strong { font-size: clamp(15px, 4.5vw, 18px); }
  .product-banner p { font-size: 10px; }
  .cube-round {
    flex-basis: 46px;
    height: 46px;
    margin-right: 9px;
  }
  .gift-art {
    right: 40px;
    transform: scale(.67);
    transform-origin: bottom right;
  }
  .product-banner em {
    right: 7px;
    font-size: 10px;
  }
  .work-stats { gap: 3px; padding: 6px; }
  .work-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .work-stats > div {
    grid-template: auto auto / 40px minmax(0, 1fr);
    min-height: 62px;
    justify-items: stretch;
    text-align: left;
  }
  .work-stats > div > span { grid-row: auto; margin: 0; width: 33px; height: 33px; }
  .work-stats > div > span { grid-row: span 2; }
  .work-stats small {
    font-size: 10px;
    white-space: normal;
  }
  .work-details article {
    grid-template: 34px auto auto / 1fr;
    justify-items: center;
    padding-inline: 4px;
    text-align: center;
  }
  .work-details article span { grid-row: auto; }
  .work-details small { margin-top: 4px; }
  .bottom-nav span { font-size: clamp(8px, 2.5vw, 10px); }
}

@media (min-width: 391px) and (max-width: 430px) {
  .app-header {
    min-height: 96px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .page-content {
    padding-right: 12px;
    padding-left: 12px;
  }

  .balance-card {
    min-height: 104px;
    padding: 15px 19px;
  }

  .stats-grid {
    gap: 0;
  }

  .stat-cell {
    min-height: 74px;
  }

  .quick-grid {
    gap: 7px;
  }

  .quick-grid button {
    min-width: 0;
    min-height: 105px;
    padding: 8px 3px;
  }

  .quick-grid button > span {
    width: 54px;
    height: 54px;
  }

  .menu-list button {
    min-height: 45px;
  }

  .product-banner {
    min-height: 112px;
  }

  .work-stats > div {
    min-height: 58px;
  }

  .empty-product {
    min-height: 154px;
  }

  .bottom-nav {
    height: 72px;
  }

  .app {
    padding-bottom: 72px;
  }

  .chat-button {
    bottom: 82px;
  }
}

@media (max-width: 350px) {
  .page-content { padding-inline: 9px; }
  .app-header {
    gap: 8px;
    padding-inline: 10px;
  }
  .avatar {
    flex-basis: 48px;
    height: 53px;
  }
  .notice-button { padding-inline: 0; }
  .quick-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .quick-grid button { min-height: 98px; }
  .product-banner > div:nth-child(2) { padding-right: 0; }
  .gift-art, .product-banner em { display: none; }
  .grab-button {
    width: 82%;
    min-width: 0;
  }
}

@media (min-width: 700px) {
  .page-content {
    padding-right: 4vw;
    padding-left: 4vw;
  }

  .app-header {
    padding-right: 5vw;
    padding-left: 5vw;
  }
}
